<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>rby1_bringup</name>
  <version>0.1.0</version>

  <description>
    Sensor and system bringup package for the real RBY1 robot.
  </description>

  <maintainer email="nvidia@example.com">nvidia</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 launch -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- LakiBeam LiDAR driver -->
  <exec_depend>lakibeam1</exec_depend>

  <!-- Static sensor transforms -->
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
