<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- Fail to the operator on a blocked leg; keep observed obstacles intact.
         Station mode is entered after success by the UI's mission sequence. -->
    <PipelineSequence name="NavigateOneStation">
      <RateController hz="1.0">
        <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
