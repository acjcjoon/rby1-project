<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!-- These are transit via points within ONE leg. Stations needing a stop,
         correction or work must each use a separate NavigateToPose action. -->
    <PipelineSequence name="NavigateViaPoints">
      <RateController hz="1.0">
        <Sequence>
          <RemovePassedGoals input_goals="{goals}" output_goals="{goals}" radius="0.15"/>
          <ComputePathThroughPoses goals="{goals}" path="{path}" planner_id="GridBased"/>
        </Sequence>
      </RateController>
      <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
    </PipelineSequence>
  </BehaviorTree>
</root>
